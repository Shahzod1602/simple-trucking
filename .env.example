# Copy to .env and fill in real values. NEVER commit the real .env.
# (.env and ratecon.db are gitignored.)

# ── AI extraction (Google Gemini) ──────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Maps / routing (optional — falls back to Nominatim/OSRM if unset) ──────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ── Telegram bot ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ratecon:CHANGE_ME@localhost:5432/ratecon
POSTGRES_PASSWORD=CHANGE_ME

# ── Platform superadmin (synced on every startup) ─────────────────────────────
# Use a strong, unique password — this is the platform owner login.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Email (Relay — relay.identify.uz) ─────────────────────────────────────────
# Master API key from relay.identify.uz/apikeys. All companies' connected
# mailboxes live under this one Relay user; ratecon maps each back to a company.
RELAY_BASE_URL=https://relay.identify.uz
RELAY_API_KEY=
# Public origin of THIS app — OAuth callback returns here. Must be added to
# Relay's CONNECT_RETURN_ALLOWLIST. Example: https://app.ratecon.example
PUBLIC_BASE_URL=
# Secret used to sign the OAuth state (falls back to SUPER_ADMIN_PASSWORD).
RELAY_STATE_SECRET=

# ── Optional toggles ───────────────────────────────────────────────────────────
# DISABLE_BOT_POLLER=0
# DISABLE_TRUCK_PREFETCH=0
# DISABLE_EMAIL_POLLER=0
# EMAIL_POLL_INTERVAL=60
